	column 'Customer ID'
		dataType: string
		isHidden
		lineageTag: 7adfb7df-6fda-4548-8405-efa5a6e983d9
		summarizeBy: none
		sourceColumn: Customer ID

		annotation SummarizationSetBy = User

	column 'Call Duration'
		dataType: int64
