		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Satisfaction Rating'
		dataType: double
		formatString: 0.0
		lineageTag: f1a542dc-42bd-4953-9ec8-cee4c685b7a5
		summarizeBy: average
		sourceColumn: Satisfaction Rating

