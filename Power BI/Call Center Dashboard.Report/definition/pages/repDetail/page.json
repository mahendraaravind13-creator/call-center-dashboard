    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F0F0ED'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "type": "Drillthrough"
