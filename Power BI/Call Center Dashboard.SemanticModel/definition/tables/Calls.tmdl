		summarizeBy: sum
		sourceColumn: Call Duration

		annotation SummarizationSetBy = User

	column 'Rep ID'
		dataType: string
		isHidden
		lineageTag: 832c3083-3c3d-48a6-a2fd-fa81af14f315
		summarizeBy: none
		sourceColumn: Rep ID

		annotation SummarizationSetBy = User

	column 'Call Date'
		dataType: dateTime
