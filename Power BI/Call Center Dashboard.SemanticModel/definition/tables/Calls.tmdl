		annotation UnderlyingDateTimeDataType = Date

	column 'Purchase Amount'
		dataType: int64
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 94f5b92f-9ed5-4f65-943e-c78ac4300cfc
		summarizeBy: sum
